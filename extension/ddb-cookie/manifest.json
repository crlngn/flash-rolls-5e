{
  "manifest_version": 3,
  "name": "Flash Token Bar – D&D Beyond Cookie Helper",
  "short_name": "FTB Cookie Helper",
  "version": "1.0.0",
  "description": "Copies your D&D Beyond login cookie so you can paste it into Flash Token Bar 5e for Foundry VTT.",
  "homepage_url": "https://github.com/crlngn/flash-rolls-5e/tree/main/extension/ddb-cookie",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.dndbeyond.com/*"],
  "action": {
    "default_title": "Copy D&D Beyond cookie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
