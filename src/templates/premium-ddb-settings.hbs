<section class="tab form-content {{tab.cssClass}}" data-group="primary-tabs" data-tab="{{tab.id}}">
  <h4> <span class="toggle-hint">{{localize 'FLASH_ROLLS.ui.dialogs.toggleHints'}}</span></h4>

  <fieldset class="ddb-options">
    <legend>{{localize "FLASH_ROLLS.settings.premiumFeatures.ddbImportOptions"}}</legend>

    {{#with ddbOptionFields.ddbImportSourcePriority}}
    <div class="form-group">
      <label for="ddbImportSourcePriority">{{label}}</label>
      <div class="form-fields">
        <select name="ddbImportSourcePriority" id="ddbImportSourcePriority">
          {{#each choices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="hint">{{{hint}}}</p>
    </div>
    {{/with}}

    {{#with ddbOptionFields.ddbImportSpellMode}}
    <div class="form-group">
      <label for="ddbImportSpellMode">{{label}}</label>
      <div class="form-fields">
        <select name="ddbImportSpellMode" id="ddbImportSpellMode">
          {{#each choices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="hint">{{{hint}}}</p>
    </div>
    {{/with}}

  </fieldset>

  <fieldset class="ddb-options">
    <legend>{{localize "FLASH_ROLLS.settings.premiumFeatures.ddbRollOptions"}}</legend>

    {{#with ddbOptionFields.ddbRollOwnership}}
    <div class="form-group">
      <label for="ddbRollOwnership">{{label}}</label>
      <div class="form-fields">
        <select name="ddbRollOwnership" id="ddbRollOwnership">
          {{#each choices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="hint">{{{hint}}}</p>
    </div>
    {{/with}}

    <div class="form-group">
      <label for="ddbNoAutoConsumeSpellSlot">{{ddbOptionFields.ddbNoAutoConsumeSpellSlot.label}}</label>
      <input type="checkbox" name="ddbNoAutoConsumeSpellSlot" id="ddbNoAutoConsumeSpellSlot" {{#if ddbNoAutoConsumeSpellSlot}}checked{{/if}} />
      <p class="hint">{{{ddbOptionFields.ddbNoAutoConsumeSpellSlot.hint}}}</p>
    </div>
  </fieldset>
</section>
