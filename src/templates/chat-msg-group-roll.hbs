<div class="flash5e-group-roll">
  <header class="group-roll-header">
    <div class="roll-flavor">
      {{flavor}}
    </div>
  </header>
  
  <div class="group-roll-list">
    {{#each results}}
    <div class="actor-result {{#unless rolled}}pending{{/unless}} {{#if success}}success{{/if}} {{#if failure}}failure{{/if}} {{#if shouldHide}}npc-hidden{{/if}} {{#if shouldHideRoll}}roll-hidden{{/if}}" data-actor-id="{{actorId}}"{{#if tokenId}} data-token-id="{{tokenId}}"{{/if}}>
      <div class="actor-summary">
        <img class="actor-image" src="{{actorImg}}" alt="{{actorName}}" />
        <span class="actor-name">{{actorName}}</span>
        <span class="roll-result">
          {{#if rolled}}
            <span class="roll-value toggle" title="Click to see roll breakdown">{{total}}</span>
          {{else}}
            <span class="adv-btn fas fa-angles-down"
                  data-action="roll"
                  data-advantage-mode="-1"
                  data-type="{{../rollType}}"
                  data-roll-key="{{../rollKey}}"
                  data-actor-id="{{actorId}}"
                  {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}}
                  data-group-roll-id="{{../groupRollId}}"
                  {{#if ../dc}}data-dc="{{../dc}}"{{/if}}
                  {{#if ../gmSituationalBonus}}data-situational-bonus="{{../gmSituationalBonus}}"{{/if}}
                  {{#if ../gmDisadvantage}}data-gm-active="true"{{/if}}
                  title="Roll with Disadvantage"></span>
            <span class="dice-btn fa-thin fa-dice-d20 fa-light rollable"
                  data-action="roll"
                  data-type="{{../rollType}}"
                  data-roll-key="{{../rollKey}}"
                  data-actor-id="{{actorId}}"
                  {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}}
                  data-group-roll-id="{{../groupRollId}}"
                  {{#if ../rollType}}{{#eq ../rollType "skill"}}data-skill="{{../rollKey}}"{{/eq}}{{/if}}
                  {{#if ../rollType}}{{#eq ../rollType "tool"}}data-tool="{{../rollKey}}"{{/eq}}{{/if}}
                  {{#if ../rollType}}{{#eq ../rollType "save"}}data-ability="{{../rollKey}}"{{/eq}}{{/if}}
                  {{#if ../rollType}}{{#eq ../rollType "ability"}}data-ability="{{../rollKey}}"{{/eq}}{{/if}}
                  {{#if ../dc}}data-dc="{{../dc}}"{{/if}}
                  {{#if ../gmAdvantage}}data-gm-advantage="true"{{/if}}
                  {{#if ../gmDisadvantage}}data-gm-disadvantage="true"{{/if}}
                  {{#if ../gmSituationalBonus}}data-situational-bonus="{{../gmSituationalBonus}}"{{/if}}
                  title="Click to roll"
                  alt="Pending Roll"></span>
            <span class="adv-btn fas fa-angles-up"
                  data-action="roll"
                  data-advantage-mode="1"
                  data-type="{{../rollType}}"
                  data-roll-key="{{../rollKey}}"
                  data-actor-id="{{actorId}}"
                  {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}}
                  data-group-roll-id="{{../groupRollId}}"
                  {{#if ../dc}}data-dc="{{../dc}}"{{/if}}
                  {{#if ../gmSituationalBonus}}data-situational-bonus="{{../gmSituationalBonus}}"{{/if}}
                  {{#if ../gmAdvantage}}data-gm-active="true"{{/if}}
                  title="Roll with Advantage"></span>
          {{/if}}
        </span>
      </div>
      {{#if rollBreakdown}}
      <div class="roll-breakdown">
        {{{rollBreakdown}}}
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>
  
  {{#if allRolled}}
    {{#if supportsDC}}
      <div class="group-roll-dc-control" data-show-to-players="{{showDCToPlayers}}">
        <div class="dc-input-container">
          <label for="dc-input-{{messageId}}-{{groupRollId}}" class="dc-input-label">DC:</label>
          <input type="number" 
                 id="dc-input-{{messageId}}-{{groupRollId}}" 
                 class="dc-input dc-input-gm-only" 
                 placeholder="Set DC" 
                 value="{{dc}}"
                 min="1" 
                 max="99"
                 data-message-id="{{messageId}}"
                 data-group-roll-id="{{groupRollId}}">
        </div>
      </div>

      {{#if groupResult.complete}}
      {{#if showGroupCalculation}}
      <div class="group-roll-footer {{#if groupResult.success}}success{{else}}failure{{/if}}" data-show-to-players="{{showResultToPlayers}}">
        <div class="group-result-summary">
          {{#if isSingleActor}}
          <span class="group-result-label">Result:</span>
          {{else}}
          <span class="group-result-label">Group Result:</span>
          {{/if}}
          {{#if groupResult.success}}
            <i class="fas fa-check-circle success-icon"></i>
            <span class="group-result-value success">Success</span>
          {{else}}
            <i class="fas fa-times-circle failure-icon"></i>
            <span class="group-result-value failure">Failure</span>
          {{/if}}
        </div>
        {{#unless isSingleActor}}
        {{#if groupSummary}}
        <div class="group-result-details">
          <span class="summary-text">{{groupSummary}}</span>
        </div>
        {{/if}}
        {{/unless}}
      </div>
      {{/if}}
      {{/if}}

      <div class="group-roll-selection-buttons gm-only" data-group-roll-id="{{groupRollId}}" data-message-id="{{messageId}}">
        <button type="button" class="select-actors-btn" data-select-type="failed" data-tooltip="Select Failed">
          <i class="fa-solid fa-user-xmark"></i>
        </button>
        <button type="button" class="select-actors-btn" data-select-type="passed" data-tooltip="Select Passed">
          <i class="fa-solid fa-user-check"></i>
        </button>
        <button type="button" class="select-actors-btn" data-select-type="all" data-tooltip="Select All">
          <i class="fa-solid fa-users"></i>
        </button>
      </div>
    {{/if}}
  {{/if}}
</div>